diff --git a/platform/src/os/apple/macos/macos_accessibility.rs b/platform/src/os/apple/macos/macos_accessibility.rs
new file mode 100644
index 000000000..ab0e90b48
--- /dev/null
+++ b/platform/src/os/apple/macos/macos_accessibility.rs
@@ -0,0 +1,67 @@
+//! One AccessKit adapter for each Makepad NSView, installed before first focus.
+use crate::{accessibility::{AccessibilityAction, WindowTreeUpdate}, cx::Cx, window::WindowId};
+use accesskit::{ActionHandler, ActionRequest, ActivationHandler, TreeUpdate};
+use accesskit_macos::{QueuedEvents, SubclassingAdapter};
+use std::{cell::{Cell, RefCell}, ffi::c_void, rc::Rc};
+
+struct InitialTree(Rc<RefCell<Option<TreeUpdate>>>);
+impl ActivationHandler for InitialTree {
+    fn request_initial_tree(&mut self) -> Option<TreeUpdate> {
+        // All accesses are on the AppKit/UI thread. No cross-thread lock.
+        self.0.borrow().clone()
+    }
+}
+
+struct Actions {
+    window_id: WindowId,
+    generation: Rc<Cell<u64>>,
+    live: Rc<Cell<bool>>,
+}
+impl ActionHandler for Actions {
+    fn do_action(&mut self, request: ActionRequest) {
+        if self.live.get() {
+            Cx::post_action(AccessibilityAction {
+                window_id: self.window_id,
+                generation: self.generation.get(),
+                request,
+            });
+        }
+    }
+}
+
+pub(crate) struct Bridge {
+    adapter: Option<SubclassingAdapter>,
+    latest: Rc<RefCell<Option<TreeUpdate>>>,
+    generation: Rc<Cell<u64>>,
+    live: Rc<Cell<bool>>,
+}
+
+impl Bridge {
+    /// `view` is the initialized content NSView, before makeFirstResponder.
+    pub(crate) unsafe fn new(view: *mut c_void, window_id: WindowId) -> Self {
+        let latest = Rc::new(RefCell::new(None));
+        let generation = Rc::new(Cell::new(0));
+        let live = Rc::new(Cell::new(true));
+        let adapter = unsafe { SubclassingAdapter::new(view, InitialTree(latest.clone()),
+            Actions { window_id, generation: generation.clone(), live: live.clone() }) };
+        Self { adapter: Some(adapter), latest, generation, live }
+    }
+
+    pub(crate) fn update(&mut self, update: WindowTreeUpdate) -> Option<QueuedEvents> {
+        if !self.live.get() { return None; }
+        self.generation.set(update.generation);
+        *self.latest.borrow_mut() = Some(update.tree.clone());
+        self.adapter.as_mut()?.update_if_active(|| update.tree)
+    }
+
+    pub(crate) fn focus(&mut self, focused: bool) -> Option<QueuedEvents> {
+        self.adapter.as_mut()?.update_view_focus_state(focused)
+    }
+
+    pub(crate) fn retire(&mut self) {
+        self.live.set(false);
+        self.latest.borrow_mut().take();
+        // Restores the original NSView class while the view is still valid.
+        self.adapter.take();
+    }
+}
