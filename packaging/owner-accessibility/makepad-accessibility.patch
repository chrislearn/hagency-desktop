new file mode 100644
index 000000000..1434a2dcc
--- /dev/null
+++ b/platform/src/accessibility.rs
@@ -0,0 +1,30 @@
+//! Window-scoped accessibility transport. The UI submits complete snapshots;
+//! platform callbacks enqueue actions and never call widgets re-entrantly.
+pub use accesskit;
+use crate::window::WindowId;
+
+#[derive(Clone, Debug)]
+pub struct WindowTreeUpdate {
+    pub window_id: WindowId,
+    /// Invalidates pending native actions when an owner/security scope changes.
+    pub generation: u64,
+    pub tree: accesskit::TreeUpdate,
+}
+
+#[derive(Clone, Debug)]
+pub struct AccessibilityAction {
+    pub window_id: WindowId,
+    pub generation: u64,
+    pub request: accesskit::ActionRequest,
+}
+
+impl crate::cx::Cx {
+    pub fn update_window_accessibility(&mut self, update: WindowTreeUpdate) {
+        self.update_accessibility_tree(Box::new(update));
+        // Trees are normally published after drawing; platform operations are
+        // drained before drawing. Wake the native loop so a resting window's
+        // AX snapshot is committed without waiting for the next user input.
+        #[cfg(target_os = "macos")]
+        crate::os::apple::macos::macos_app::wake_event_loop();
+    }
+}
