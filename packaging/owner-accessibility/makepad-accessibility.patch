+    /// Semantic popup entries use the actual drawn item widgets for bounds.
+    pub fn accessibility_items(&self) -> Vec<(usize, String, WidgetRef)> {
+        if !self.is_active { return Vec::new(); }
+        let Ok(map) = self.popup_global.map.try_borrow() else { return Vec::new() };
+        let Some(menu) = map.get(&self.popup_menu_key()) else { return Vec::new() };
+        let mut entries: Vec<_> = menu.item_refs().filter_map(|(id, item)| {
+            let index = id.0 as usize;
+            self.labels.get(index).map(|label| (index, label.clone(), item))
+        }).collect();
+        entries.sort_by_key(|(index, _, _)| *index);
+        entries
+    }
+
+    pub fn accessibility_is_expanded(&self) -> bool { self.is_active }
+
+    pub fn accessibility_select(&mut self, cx: &mut Cx, index: usize) {
+        if !self.is_active || index >= self.labels.len() { return; }
+        self.selected_item = index;
+        cx.widget_action_with_data(&self.action_data, self.uid, DropDownAction::Select(index));
+        self.set_closed(cx);
+    }
+
     pub fn selected_item_index(&self) -> usize {
         self.selected_item
     }
